        </mxCell>

        <mxCell id="privatelink" value="AWS PrivateLink&#10;egress via central account&#10;+ Firewall / IPS" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#8C4FFF;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.privatelink;" vertex="1" parent="1">
          <mxGeometry x="1810" y="380" width="70" height="70" as="geometry" />
        </mxCell>

        <mxCell id="mstr" value="MicroStrategy (live REST)&#10;vendor-hosted · service account only&#10;base: .../MicroStrategyLibrarySTD&#10;login mode 1 · X-MSTR-AuthToken&#10;rate-limited by worker concurrency cap" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=11;align=center;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1740" y="600" width="220" height="100" as="geometry" />
        </mxCell>

        <mxCell id="mstrEM" value="MSTR Enterprise Manager /&#10;platform logs&#10;show SERVICE ACCOUNT only —&#10;join key: svc acct + timestamp + jobId" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=11;align=center;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="1740" y="840" width="220" height="90" as="geometry" />
        </mxCell>

        <!-- ===================== CROSS-CUTTING BAND ===================== -->
        <mxCell id="laneX" value="CROSS-CUTTING · OBSERVABILITY · ALERTING · AGENTIC-AI CIRCUIT BREAKER (mandatory — RAE ADR)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#82B366;dashed=1;verticalAlign=top;fontSize=14;fontStyle=1;align=center;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="1190" width="1200" height="330" as="geometry" />
        </mxCell>

        <mxCell id="cloudwatch" value="Amazon CloudWatch&#10;structured JSON logs + alarms&#10;every line: correlation_id · user_id" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#E7157B;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cloudwatch_2;" vertex="1" parent="1">
          <mxGeometry x="140" y="1260" width="70" height="70" as="geometry" />
        </mxCell>

        <mxCell id="sns" value="Amazon SNS&#10;on-call notification&#10;DLQ depth · error-rate ·&#10;breaker-trip alarms" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#E7157B;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.simple_notification_service;" vertex="1" parent="1">
          <mxGeometry x="380" y="1260" width="70" height="70" as="geometry" />
        </mxCell>

        <mxCell id="ssm" value="AWS Systems Manager&#10;Parameter Store — breaker flags&#10;agent → category → subsystem&#10;no redeploy to trip · trips audit-logged" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#E7157B;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.systems_manager;" vertex="1" parent="1">
          <mxGeometry x="620" y="1260" width="70" height="70" as="geometry" />
        </mxCell>

        <mxCell id="riskPanel" value="ACCEPTED RISKS &amp; CONTROLS&#10;&#10;R1 Single-region deployment — accepted (internal admin tool). Control: RDS Multi-AZ, IaC redeploy runbook. RTO 4h / RPO 15m (automated backups).&#10;R2 Prompt injection via MSTR object names / user images — Controls: tool allowlist, read-only default, HITL gate on all mutations, no tool can alter its own allowlist.&#10;R3 Runaway agent loop — Controls: max 15 iterations/job, per-session Bedrock token budget, circuit breaker pre-call check.&#10;R4 Vendor MSTR overload — Control: worker concurrency cap (N=4 concurrent MSTR sessions), exponential backoff on 5xx.&#10;R5 Mixed RDS load (OLTP + pgvector + pg_cron MV) — accepted at current scale; Control: Performance Insights watch, read-replica escape hatch documented.&#10;R6 Screenshot may contain client data — Control: images ephemeral (in-memory base64 → Converse), never persisted; only SHA-256 hash in audit table.&#10;R7 Service account is a shared high-privilege identity — Controls: Secrets Manager + rotation, IRSA-scoped access, full per-call attribution via audit table (step 12)." style="text;html=1;align=left;verticalAlign=top;fontSize=10;fontColor=#33691E;fillColor=#FFFFFF;strokeColor=#82B366;rounded=1;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="740" y="1230" width="480" height="270" as="geometry" />
        </mxCell>

        <!-- ===================== STEP COMMENTARY PANEL ===================== -->
        <mxCell id="commentary" value="STEP COMMENTARY&#10;&#10;1  User authenticates — ALB Okta OIDC (built-in). JWT carries sub + email.&#10;2  ALB → FastAPI pod; RBAC enforced per user role. Internal ingress only.&#10;3  FastAPI writes session record to RDS: user_id + session_id + chat turns.&#10;4  Interactive chat: FastAPI ↔ Bedrock Converse (streaming). User images pass through as inline base64 content blocks (&lt;3.75MB) — ephemeral, never persisted; SHA-256 hash logged to audit table.&#10;5  Long-running admin action: FastAPI mints correlation_id, enqueues SQS msg with attrs {user_id, session_id, correlation_id}. maxReceive=3 → DLQ.&#10;6  Worker consumes; identity attrs travel with the message — never inferred.&#10;7  Worker agent loop: Bedrock Converse + MCP tool definitions. Max 15 iterations; per-session token budget.&#10;8  Bedrock returns toolUse → worker executes matching MCP tool. Breaker flag checked before every call.&#10;9  Worker fetches service account creds from Secrets Manager (IRSA; cached, TTL).&#10;10 MCP tool fires MSTR REST via PrivateLink. requests.Session(); login mode 1; X-MSTR-AuthToken + cookies; ERR009 re-auth; long polls; concurrency cap N=4.&#10;11 MSTR returns jobId / instanceId — captured verbatim.&#10;12 Worker writes AUDIT row: correlation_id, user_id, session_id, tool_name, endpoint, MSTR jobId, timestamps, approver (if HITL). System of record.&#10;13 Worker updates job_status (live progress).&#10;14 FastAPI polls job_status → UI shows progress.&#10;15 KB retrieval: worker queries RDS pgvector, injects context into prompt.&#10;16 Nightly: EventBridge Scheduler → EKS batch pod (Track B).&#10;17 Circuit breaker: worker reads SSM Parameter Store flag pre-call.&#10;18 All pods emit structured CloudWatch logs keyed by correlation_id.&#10;19 OFFLINE JOIN (dashed): audit table ↔ MSTR EM logs via svc acct + timestamp + jobId — answers &quot;which human ran this call.&quot;&#10;&#10;— HITL FLOW —&#10;20 Tool on destructive allowlist → worker pauses loop, sets job_status = AWAITING_APPROVAL with proposed action payload.&#10;21 FastAPI surfaces approval card in UI; user approves/rejects. Decision + approver identity written to RDS approvals table.&#10;22 Worker resumes only on recorded approval; executes; audit row includes approver. Reject → loop ends gracefully, user informed.&#10;&#10;— BINARY / EXPORT FLOW —&#10;23 Export tools (dossier PDF/XLSX, .mmp packages) → worker streams binary to S3 transient bucket (SSE-KMS, 24h lifecycle).&#10;24 Presigned GET URL returned to user via job result. Nothing binary touches RDS.&#10;&#10;— ALERTING —&#10;25 CloudWatch alarms (DLQ depth &gt; 0, error rate, breaker trip) → SNS → on-call." style="text;html=1;align=left;verticalAlign=top;fontSize=10;fontColor=#232F3E;fillColor=#FFFFFF;strokeColor=#999999;rounded=1;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1260" y="1190" width="770" height="640" as="geometry" />
        </mxCell>

