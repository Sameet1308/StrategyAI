  <diagram id="strategy-ai-bot-final-v3" name="Architecture FINAL v3 (binary + HITL + risks)">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2340" pageHeight="1900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- ===================== TITLE ===================== -->
        <mxCell id="title" value="Strategy AI BOT Framework — Solution Architecture on AWS (FINAL v3 — approved services only)&#10;Direct Bedrock Converse (no Agent service) · MCP tool layer on EKS worker · user→service-account audit correlation · HITL gate · transient binary path · alerting" style="text;html=1;align=left;verticalAlign=top;fontSize=18;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1800" height="60" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Every arrow is numbered — see STEP COMMENTARY (bottom right). Identity chain: Okta user → session_id → correlation_id → SQS attrs → worker → RDS audit table → MSTR jobId join. MSTR sees only the service account; the RDS audit table is the system of record. See companion doc for full design detail." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#B85450;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="40" y="80" width="1800" height="40" as="geometry" />
        </mxCell>

        <!-- ===================== LANE A: INGRESS / IDENTITY ===================== -->
        <mxCell id="laneA" value="INGRESS · IDENTITY" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;dashed=1;verticalAlign=top;fontSize=14;fontStyle=1;align=center;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="140" width="330" height="1020" as="geometry" />
        </mxCell>

        <mxCell id="user" value="Architect / LOB Admin&#10;(corporate network)&#10;chat + image upload + approvals" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#232F3E;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;aspect=fixed;shape=mxgraph.aws4.user;" vertex="1" parent="1">
