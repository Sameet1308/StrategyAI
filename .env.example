# =============================================================
# Strategy (MicroStrategy) Dual-Server Configuration
# =============================================================

# PROD server (source — extract lineage data)
MSTR_PROD_BASE_URL=https://prod-server/MicroStrategyLibrary/api

# DEV server (target — publish lineage cubes)
MSTR_DEV_BASE_URL=https://dev-server/MicroStrategyLibrary/api

# Credentials (same user has access to both servers)
MSTR_USERNAME=your_username
MSTR_PASSWORD=your_password

# DEV target: project and folder where lineage cubes will be published
MSTR_DEV_PROJECT_ID=your_dev_project_id
MSTR_DEV_FOLDER_ID=your_dev_folder_id

# PROD source: comma-separated project IDs to extract lineage from
MSTR_PROD_PROJECT_IDS=project_id_1,project_id_2,project_id_3

# =============================================================
# Legacy single-server config (for simple admin scripts)
# =============================================================
# MSTR_BASE_URL=https://your-server/MicroStrategyLibrary/api
# MSTR_PROJECT_ID=
# MSTR_VERIFY_SSL=true

# =============================================================
# StrategyAI BOT backend (backend/ FastAPI app)
# =============================================================
# Mock adapters run the whole app offline — flip to false for live systems.
STRATEGYAI_MOCK_MSTR=true
STRATEGYAI_MOCK_LLM=true

# Live MSTR: uses MSTR_BASE_URL + MSTR_USERNAME + MSTR_PASSWORD above
# (single admin service account; per-user identity stays in the audit log).

# Live LLM: Claude on Amazon Bedrock (AWS credentials from the environment,
# e.g. IRSA in EKS or `aws configure` locally).
# AWS_REGION=us-east-1
# BEDROCK_MODEL_ID=anthropic.claude-sonnet-5

# Database: SQLite by default; point at RDS Postgres in the client account.
# STRATEGYAI_DATABASE_URL=postgresql+psycopg://user:pass@host:5432/strategyai

# Identity: true in prod (ALB + Okta OIDC forwards x-amzn-oidc-data).
# STRATEGYAI_REQUIRE_ALB_AUTH=true
# STRATEGYAI_DEV_USER=dev.admin@local

# Confirmation window for mutating actions (seconds)
# STRATEGYAI_ACTION_TTL_SECONDS=900
